# Public site settings (REQUIRED before launch: run `npm run check:launch`)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_TARGET_REGIONS=worldwide

# Contact form (Web3Forms access key). Leave empty to show a mailto button only.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Consent: "custom" (built-in banner, non-personalised ads only) or "google-fc" (Google Funding Choices, a certified CMP)
NEXT_PUBLIC_CMP_MODE=custom

# AdSense. Everything below stays OFF until Google approves the site.
NEXT_PUBLIC_ADSENSE_ID=
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_AD_SLOT_TOOL_BELOW=
NEXT_PUBLIC_AD_SLOT_ARTICLE=

# Optional analytics / monitoring (consent-gated, filenames scrubbed)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Set to true in CI/production builds to fail when the three required site settings are missing
STRICT_SITE_CONFIG=false
