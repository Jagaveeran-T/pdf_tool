{
  "name": "pdf-tools",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out -l 4173 --no-clipboard",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
